DB_HOST=localhost
DB_DATABASE=contact_center
# Usuario con solo SELECT/INSERT/UPDATE/DELETE. Se crea con: composer db-user
DB_USERNAME=cc_app
DB_PASSWORD=

# --- AWS (SES para email, SNS para SMS, Polly para audio) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Solo para credenciales temporales STS (claves que empiezan por ASIA...)
AWS_SESSION_TOKEN=

# Remitente por defecto de los emails. DEBE ser una identidad verificada en SES.
# Si hay un remitente marcado como predeterminado en la aplicacion, manda ese.
MAIL_FROM=
# Nombre visible, p.ej. "Contact Center" -> Contact Center <info@tudominio.com>
MAIL_FROM_NAME=

# Revisión de links de los emails antes de enviar. strict (por defecto) bloquea
# links peligrosos o de phishing y pide confirmar los avisos; warn solo avisa.
LINK_CHECK_MODE=strict
# Dominios propios del cliente que no generan el aviso "dominio distinto al
# remitente" (separados por comas). El del remitente y los verificados ya cuentan.
LINK_ALLOWED_DOMAINS=
# Acortadores adicionales a tratar como públicos (separados por comas).
LINK_SHORTENERS_EXTRA=

APP_ENV=production
APP_DEBUG=false

# --- SMS: proveedor IT Cloud Services (contacto-virtual.com). Cada cliente
# usa su cuenta: deploy.sh / bin/sms-setup.php piden el email y el token
# (se crea en la plataforma, opción Configuraciones).
# ITCLOUD_SMS_TYPE: 1via | 2via | flash. ---
ITCLOUD_SMS_EMAIL=
ITCLOUD_SMS_TOKEN=
ITCLOUD_SMS_TYPE=1via
# Secreto de la URL de respuestas (doble vía): <APP_URL>/api/sms/inbound/<secreto>.
# deploy.sh lo genera; se le informa esa URL completa al proveedor.
SMS_INBOUND_SECRET=

# --- WhatsApp (Gupshup Partner API). bin/whatsapp.php activate los rellena
# con las credenciales de partner de Vozip (que NO se guardan aquí): solo
# queda el token de la app de este cliente. WHATSAPP_WEBHOOK_SECRET autentica
# los eventos que Gupshup envía a <APP_URL>/api/webhooks/whatsapp. ---
GUPSHUP_APP_ID=
GUPSHUP_APP_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
# La rellena "whatsapp.php subscribe" cuando Gupshup acepta el webhook.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_ONBOARDING_LINK=

# --- API de voz (TTS + Asterisk). deploy.sh / bin/voice-setup.php crean el
# usuario de esta instalación y rellenan VOICE_API_KEY (y USER/PASSWORD). ---
VOICE_API_URL=http://indoor-qvmdkkckkpc.dynamic-m.com:8000
VOICE_API_KEY=
VOICE_API_USER=
VOICE_API_PASSWORD=
VOICE_CALL_THROTTLE_MS=1500

# Valores de desarrollo (vite en :5173 + php en :8000). En produccion usa
# VITE_API_URL=/api y pon en APP_URL y CORS_ALLOWED_ORIGIN el origen real
# (p.ej. https://midominio.com o http://192.168.1.10), sin "/" final.

# URL publica base del backend. Se usa para las imagenes de los editores y para
# la URL de baja de los envios, asi que debe ser accesible desde Internet.
APP_URL=http://localhost:8000

CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api

# --- Autenticacion JWT ---
# Genera los secretos con: composer secrets
JWT_SECRET=
# Token de acceso: 2 horas (la app lo renueva sola con el refresh token).
JWT_EXPIRY=7200
# Refresh token: 7 dias sin uso y hay que volver a iniciar sesion.
JWT_REFRESH_EXPIRY=604800

# --- Admin inicial. Se crea/actualiza con: composer seed-admin ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@contactcenter.local
ADMIN_PASSWORD=

# Cuenta de AWS compartida entre instalaciones: un dominio o correo que ya
# existe en SES pero no en esta instalación se considera de otro cliente y no
# se puede registrar. Pon true solo temporalmente (p.ej. al reinstalar a un
# cliente con base de datos nueva) y vuelve a false.
SES_ALLOW_EXISTING_IDENTITIES=false

# Poner en true solo si la aplicacion esta detras de un proxy inverso de
# confianza (Nginx, balanceador) que fije X-Forwarded-For.
TRUST_PROXY=false

# --- Coste estimado de SMS ---
# Precio por SEGMENTO (no por mensaje: un SMS largo son varios segmentos).
# Varia segun el pais de destino; consultalo en la tabla de precios de Amazon
# SNS. Con 0 el compositor no muestra importe.
SMS_PRICE_PER_SEGMENT=0
SMS_PRICE_CURRENCY=USD
