{
    "name": "contact-center/application",
    "description": "Contact Center Application with Email, SMS, and Audio capabilities",
    "type": "project",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.300",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "phpmailer/phpmailer": "^6.9",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "slim/php-view": "^3.2",
        "php-di/php-di": "^7.0",
        "respect/validation": "^2.2",
        "firebase/php-jwt": "7.0",
        "aws/aws-php-sns-message-validator": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "seed-admin": "php bin/seed-admin.php",
        "dispatch": "php bin/dispatch-campaigns.php",
        "secrets": "php bin/generate-secrets.php",
        "db-user": "php bin/setup-db-user.php",
        "backup": "php bin/backup-db.php",
        "credits": "php bin/credits.php",
        "voice-setup": "php bin/voice-setup.php",
        "sms-setup": "php bin/sms-setup.php",
        "whatsapp": "php bin/whatsapp.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "process-timeout": 0
    }
}
